# Base de dados (Postgres 16, RDS na UE em produção)
DATABASE_URL=postgres://n5:n5@localhost:5432/n5

# Sessões da equipa: string aleatória com 32+ caracteres
SESSION_SECRET=troca-isto-por-uma-string-aleatoria-longa

# Endereço público da app (para links nos alertas)
APP_URL=http://localhost:3000

# Stripe: segredo do endpoint de webhooks
STRIPE_WEBHOOK_SECRET=

# GitHub App: segredo dos webhooks
GITHUB_WEBHOOK_SECRET=

# Slack: signing secret da app da comunidade N5 e token do bot (para responder em threads)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_ALERTS_CHANNEL=n5-alertas

# Meta Marketing API: token de sistema com ads_read
META_ACCESS_TOKEN=
META_API_VERSION=v23.0

# Tarefas agendadas (alertas, sincronização Meta, snapshot do MRR): segredo partilhado com o agendador
CRON_SECRET=

# E-mail (módulo Reativação): Amazon SES na UE. Sem SES_FROM_ADDRESS os envios ficam simulados.
# O endereço tem de estar verificado no SES, com SPF, DKIM e DMARC no domínio.
SES_FROM_ADDRESS=
SES_REGION=eu-west-1

# Câmbio USD -> EUR usado no registo de consumo enquanto não houver taxa diária
USD_EUR_RATE=0.87
